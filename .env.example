# ──────────────────────────────────────────────
#  AI QA Agent — Environment Variables
# ──────────────────────────────────────────────
#  Copy this file to .env and fill in your values:
#    copy .env.example .env
# ──────────────────────────────────────────────

# Google GenAI API key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Test credentials (used by generated tests, not hardcoded into code)
TEST_EMAIL=your_test_email
TEST_PASSWORD=your_test_password

# Optional: override the model (also settable in config.yaml)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: API base URL for API testing mode
# API_BASE_URL=https://your-api.com
